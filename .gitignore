# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Test / lint / coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Packaging artifacts
*.egg-info/
.eggs/
pip-wheel-metadata/

# Editors / IDEs
.idea/
*.swp
.DS_Store

# VS Code:
# ignore everything by default, but keep useful project settings if desired
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Generated outputs
output/**
!output/.gitkeep

# Large/local scientific data
*.npz
*.mat
*.xyz

# Generated figures and exports
*.eps

# Keep data folder structure, but not real datasets
!data/
!data/**/
!data/**/.gitkeep
!data/README.md

# ML artifacts
*.keras
*.h5
*.weights.h5

# Notebook leftovers
.ipynb_checkpoints/